# Copia a .env (local) o configura estas variables en Railway.

# --- Base de datos (Supabase → Project Settings → Database → Connection string) ---
# Usa el "Connection Pooler" (puerto 6543) para Railway.
# Si se omite, el backend arranca en modo memoria (solo para desarrollo).
DATABASE_URL=postgresql://postgres.xxxx:CONTRASENA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# --- Auth (Supabase → Project Settings → API → JWT Secret) ---
# Si se omite y NODE_ENV != production, se habilita auth DEV por header X-Dev-User.
SUPABASE_JWT_SECRET=tu-jwt-secret-de-supabase

# --- CORS: orígenes del frontend, separados por coma ---
CORS_ORIGINS=https://chechoelgris.github.io,https://dnd-2024.pages.dev

# --- Railway inyecta PORT automáticamente; en local puedes fijarlo ---
PORT=3000
NODE_ENV=development
